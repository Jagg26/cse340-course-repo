<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>
    <ul>
        <li>
            Date: <%= project.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            }) %>
        </li>
        <li>Location: <%= project.location %></li>
        <li>
            Partner Organization:
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </li>
    </ul>
    <% if (isLoggedIn) { %>
        <h2>Volunteer</h2>
        <% if (isVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form class="inline-form" action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                <button type="submit">Remove Me as a Volunteer</button>
            </form>
        <% } else { %>
            <form class="inline-form" action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for This Project</button>
            </form>
        <% } %>
    <% } %>
    <h2>Categories</h2>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories found for this project.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
