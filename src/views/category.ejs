<%- include('partials/header') %>
<main>
    <h1><%= category.name %></h1>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>
    <% } %>
    <h2>Service Projects</h2>
    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    <% if (project.date) { %>
                        - <%= project.date.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        }) %>
                    <% } %>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects found for this category.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
